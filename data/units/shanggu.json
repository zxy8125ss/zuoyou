447.3L462.9,447.3L490,447.3M-10,350.6L-8.6,350.6L34.3,350.6L77.1,350.6L120,350.6L162.9,350.6L205.7,350.6L248.6,350.6L291.4,350.6L334.3,350.6L377.1,350.6L420,350.6L462.9,350.6L490,350.6M-10,248.9L-8.6,248.9L34.3,248.9L77.1,248.9L120,248.9L162.9,248.9L205.7,248.9L248.6,248.9L291.4,248.9L334.3,248.9L377.1,248.9L420,248.9L462.9,248.9L490,248.9M-10,140.8L-8.6,140.8L34.3,140.8L77.1,140.8L120,140.8L162.9,140.8L205.7,140.8L248.6,140.8L291.4,140.8L334.3,140.8L377.1,140.8L420,140.8L462.9,140.8L490,140.8M-10,24.5L-8.6,24.5L34.3,24.5L77.1,24.5L120,24.5L162.9,24.5L205.7,24.5L248.6,24.5L291.4,24.5L334.3,24.5L377.1,24.5L420,24.5L462.9,24.5L490,24.5","marks":[[368.6,110.8,"牛河梁"],[377,342.9,"良渚"],[358.3,236.3,"陵阳河"],[93.1,235.1,"林家"],[221.1,255.2,"庙底沟"]],"layers":[{"y":-3000,"polities":[{"tone":"cn","name":"仰韶文化","d":"M102.9,217.2L171.4,200.1L257.1,210.8L277.7,253.1L231.4,278L137.1,273.9L102.9,259.4Z","l":[188.6,240.5]},{"tone":"cn","name":"大汶口文化","d":"M300,210.8L360,193.6L411.4,200.1L382.3,246.8L348,265.6L308.6,263.5L294.9,248.9Z","l":[336,236.3]},{"tone":"cn","name":"红山文化","d":"M334.3,53.3L394.3,48.5L432,88.4L402.9,127.3L363.4,136.3L336,113.7Z","l":[377.1,86.1]},{"tone":"cn","name":"良渚文化","d":"M356.6,306.6L409.7,314.7L409.7,338.7L394.3,352.6L370.3,354.6L358.3,338.7Z","l":[382.3,328.7]},{"tone":"cn","name":"屈家岭文化","d":"M210.9,302.5L284.6,306.6L308.6,344.7L265.7,370.3L222.9,366.4L209.1,338.7Z","l":[248.6,334.7]},{"tone":"cn","name":"马家窑文化","d":"M37.7,197.9L113.1,202.2L125.1,240.5L94.3,265.6L51.4,257.3L34.3,234.2Z","l":[77.1,227.9]}],"labels":[]}]}},{"type":"spans","title":"各地文化的年代","desc":"同一时期，不同地区的文化并行发展；横条越长，延续越久。","from":-5000,"to":-1500,"rows":[["仰韶文化",-5000,-3000,"cn"],["红山文化",-4700,-2900,"cn"],["大汶口文化",-4200,-2600,"cn"],["屈家岭文化",-3400,-2600,"cn"],["良渚文化",-3300,-2300,"cn"],["马家窑文化",-3300,-2050,"cn"],["龙山文化",-2600,-2000,"cn"],["石家河文化",-2600,-2000,"cn"],["陶寺遗址",-2300,-1900,"cn"],["齐家文化",-2300,-1500,"cn"]],"note":"年代均为约数，不同研究略有出入。"},{"type":"think","title":"想一想","q":"为什么用「满天星斗」形容中国文明的起源？各地文化最终又为什么会「多元一体」？","a":"「满天星斗」是说文明起源不是从一个中心向外扩散，而是在辽河、黄河、长江等多个地区几乎同时出现，各有特色。「多元一体」是说这些文化在长期交流中相互吸收：良渚的玉琮出现在北方，龙山的城址遍布各地。中原地处交通要冲，便于汲取四方文化，夏商周最终在这里兴起，把各地传统融合为共同的礼乐文明。"},{"type":"events","title":"相关事件","ids":["CN-m3300-hongshan","CN-m3300-liangzhu","CN-m3000-linjia","CN-m2800-dawenkou","CN-m2700-silk"]},{"type":"quiz","items":[{"q":"牛河梁的女神庙、积石冢属于哪种文化？","opts":["良渚文化","红山文化","仰韶文化","大汶口文化"],"ans":1,"exp":"牛河梁位于辽宁西部，是红山文化晚期的大型祭祀中心。"},{"q":"「满天星斗」这一说法强调的是什么？","opts":["中国文明起源于一个中心","中国文明起源于多个地区","中国最早的文明在天文学方面","中国文字起源很早"],"ans":1,"exp":"它强调中国文明起源的多元性：多个地区的文化同时发展。"}]}],"no":1},{"id":"sg-L2","side":"cn","title":"走向早期国家：古城、礼器与观象台","lead":"良渚、陶寺、石峁三座古城相距上千公里，却都在五千至四千年前达到鼎盛。它们为什么被认为已经是「国家」？","modules":[{"type":"flow","title":"从村落到早期国家","steps":[["农业进步","稻、粟产量提高，出现剩余粮食"],["人口增长","聚落扩大，出现中心聚落"],["分工与分层","工匠、祭司、首领脱离生产，贫富悬殊"],["城与礼制","修城墙、建宫殿，用玉器、彩绘陶器表示等级"],["早期国家","权力集中于少数人，能调动大量人力修建公共工程"]],"key":4},{"type":"article","title":"三座古城","sections":[{"h":"良渚：玉与水坝","p":["良渚古城面积约 300 万平方米，城外有 11 条水坝构成的水利系统，可以防洪、蓄水和运输。修建这些工程需要上千人连续劳作多年，说明有一个强有力的组织者。","良渚大墓中的玉琮上刻着统一的「神人兽面」纹，各地良渚遗址的神徽几乎一模一样，显示出统一的信仰和权力网络。"]},{"h":"陶寺：观象台与「文」字","p":["陶寺城址约 280 万平方米，宫殿区、仓储区、墓地分区明确。大墓中有彩绘龙盘、鼍鼓、石磬等礼乐器，小墓几乎一无所有。","城东南一座半圆形建筑的夯土柱缝，正好对准一年中不同节气的日出方位，被认为是观象授时的「观象台」。一件陶壶上用朱砂写着一个「文」字，是探索汉字起源的重要线索。"],"quote":{"t":"乃命羲和，钦若昊天，历象日月星辰，敬授人时。","src":"《尚书·尧典》"}},{"h":"石峁：北方的石城","p":["石峁古城总面积约 400 万平方米，城墙用石块砌筑，外城东门有瓮城、马面等防御设施，皇城台上嵌着雕刻神面的石块。","石峁与陶寺大致同时，一南一北，说明当时中国北方也有强大的政治中心。"]}]},{"type":"compare","title":"三座古城比一比","cols":["良渚","陶寺","石峁"],"rows":[["年代","约前3300—前2300","约前2300—前1900","约前2300—前1800"],["位置","浙江余杭","山西襄汾","陕西神木"],["面积","约 300 万平方米（内城）","约 280 万平方米","约 400 万平方米"],["代表发现","水坝、玉琮、神徽","观象台、朱书「文」字、龙盘","石城墙、神面石雕、瓮城"],["衰落","约前2300，可能与洪水有关","约前1900，遭暴力破坏","约前1800 后废弃"]]},{"type":"think","title":"先想后看","q":"西方学者常以城市、文字、青铜器作为文明的「三要素」。良渚没有发现成熟文字和青铜器，为什么仍被认为进入了文明社会？","a":"「三要素」主要来自两河流域和埃及的经验，并不适用于所有地区。中华文明探源工程提出了更具普遍性的标准：生产发展、人口集中出现城市、社会分化形成阶级、权力集中出现王、形成区域性的国家。良渚有大型城市和水利工程、明显的等级墓葬、统一的神权信仰和调动大量人力的能力，符合这些标准。2019 年良渚列入世界遗产，说明这一认识得到了国际学界的认可。"},{"type":"events","title":"相关事件","ids":["CN-m2600-longshan","CN-m2600-shijiahe","CN-m2300-taosi","CN-m2300-shimao","CN-m2300-liangzhufall","CN-m2300-qijia"]},{"type":"quiz","items":[{"q":"陶寺遗址中被认为用于确定节气的建筑是？","opts":["水坝","观象台","瓮城","祭坛"],"ans":1,"exp":"陶寺城东南的半圆形夯土建筑，柱缝对准不同节气的日出方位，被认为是观象台。"},{"q":"良渚古城外的水利系统由多少条水坝组成？","opts":["3 条","7 条","11 条","20 条"],"ans":2,"exp":"良渚古城外围水利系统由 11 条水坝组成，是世界上最早的大型水利工程之一。"}]}],"no":2},{"id":"sg-L3","side":"cn","title":"传说时代：从炎黄到大禹","lead":"在文字出现之前，人们靠口耳相传记住祖先的故事。黄帝、尧、舜、禹是真实的人吗？传说里藏着哪些真实的历史？","modules":[{"type":"source","title":"司马迁怎样写黄帝","text":"学者多称五帝，尚矣。然《尚书》独载尧以来；而百家言黄帝，其文不雅驯，荐绅先生难言之。","src":"司马迁《史记·五帝本纪》太史公曰","plain":"学者们常说五帝，年代已经很久远了。但《尚书》只记载尧以后的事；诸子百家说到黄帝，文字不雅正，有学问的人都难以说清楚。","q":"司马迁把五帝写进了《史记》，又承认这些材料「不雅驯」。你怎样理解他的做法？今天我们该怎样看待这些传说？","a":"司马迁实地走访各地，发现长老们讲述的黄帝、尧舜故事虽有差异，但大体一致，于是选择相对可靠的材料写成《五帝本纪》，同时坦白材料的局限，体现了严谨的史学态度。今天，学界一般把五帝看作「传说时代」：具体人物和事件难以确证，但传说中部族战争、联合、推选首领、治理洪水等情节，与龙山时代城址林立、战争频繁、社会走向集权的考古发现相吻合，可以作为理解历史的线索。"},{"type":"steps","title":"传说中的世系","items":[["黄帝","阪泉、涿鹿之战后成为共主，号轩辕氏"],["颛顼","黄帝之孙，传说「绝地天通」，整顿宗教"],["帝喾","黄帝曾孙，传为尧、契（商祖）、后稷（周祖）之父"],["尧","陶唐氏，命羲和制历，禅位于舜"],["舜","有虞氏，以孝闻名，命禹治水"],["禹","治水成功，划九州，涂山会诸侯"],["启","禹之子，继位为王，「家天下」开始"]],"src":"据《史记·五帝本纪》《夏本纪》，属传说"},{"type":"people","title":"传说中的人物","ids":["huangdi","yao","shun","yu"]},{"type":"think","title":"想一想","q":"从尧舜「禅让」到禹传位给儿子启，权力交接方式发生了什么变化？这说明了什么？","a":"禅让是首领推举贤者继位，传说中的「天下为公」；启继位则是父死子继的世袭，即「天下为家」。这一变化反映出首领的权力和财富已经大到可以传给子孙，部落联盟向世袭王朝国家转变。夏朝的建立，一般被视为中国早期国家正式形成的标志。"},{"type":"events","title":"相关事件","ids":["CN-m2700-huangdi","CN-m2200-yaoshun","CN-m2100-yu"]},{"type":"quiz","items":[{"q":"「天下为家」开始于谁继承王位？","opts":["舜继尧","禹继舜","启继禹","颛顼继黄帝"],"ans":2,"exp":"禹死后，其子启继位，由禅让转为世袭，夏朝由此开始。"},{"q":"传说大禹治水与其父鲧的方法有何不同？","opts":["禹用堵，鲧用疏","禹用疏，鲧用堵","都用疏","都用堵"],"ans":1,"exp":"鲧筑堤堵水失败，禹改用疏导之法，开渠引水入海。"}]}],"no":3},{"id":"sg-L4","side":"world","title":"两河流域：城市、文字与第一个帝国","lead":"在今天伊拉克的两条大河之间，人类建起了最早的城市，发明了最早的文字，也诞生了最早的帝国。这片土地为什么能「领先一步」？","modules":[{"type":"phases","title